{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=StaffDesk;Username=postgres;Password=password123"
    },
  "JwtSettings": {
    "Issuer": "StaffDesk",
    "Audience": "StaffDeskUsers",
    "ExpiryMinutes": 15
    },
  "Retention": {
    "AuditEventsDays": 2555,
    "TaskActivityDays": 730,
    "NotificationsDays": 180,
    "SoftDeletedTasksDays": 365,
    "SessionRecordsDays": 90
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "o"
      }
    }
  },
  "AllowedHosts": "*",
  "Operations": {
    "WorkerHeartbeatMaxAgeSeconds": 90,
    "JobQueueOldestAgeWarnSeconds": 300,
    "RollupStalenessWarnHours": 36,
    "HttpErrorRateWarnPercent": 1.0,
    "DeadJobsWarnCount": 1
  },
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "LockoutAfterFailures": 5,
    "LockoutMinutes": 15,
    "DelayBaseMs": 200,
    "DelayMaxMs": 4000
  },
  "RateLimits": {
    "AuthPerMinute": 10,
    "ExportPerMinute": 5,
    "WritePerMinute": 100,
    "ReadPerMinute": 300
  }
}